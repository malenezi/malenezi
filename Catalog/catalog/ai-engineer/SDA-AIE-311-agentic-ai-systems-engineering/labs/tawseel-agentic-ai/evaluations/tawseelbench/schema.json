{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tawseel.example/tawseelbench/scenario.schema.json",
  "title": "TawseelBench scenario",
  "description": "The tau-bench / tau-cubed-bench shaped scenario anatomy (SPEC §6): customer request -> applicable policy -> environment state -> available tools -> expected state transition -> pass/fail criteria. Validated by evaluations/tawseelbench/validate.py (a small stdlib validator -- jsonschema is not installable in this build sandbox).",
  "type": "object",
  "required": [
    "id", "title", "locale", "difficulty", "domains", "intent", "tags",
    "customer_request", "applicable_policy", "environment_state",
    "available_tools", "expected_state_transition", "pass_fail_criteria",
    "notes_for_instructor"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TB-[0-9]{3}$",
      "description": "TB-001 .. TB-060"
    },
    "title": { "type": "string", "minLength": 1 },
    "locale": {
      "type": "string",
      "enum": ["ar", "en", "mixed"],
      "description": "The dominant language of customer_request.text."
    },
    "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["orders", "logistics", "billing", "customer", "security"] }
    },
    "intent": {
      "type": "string",
      "enum": [
        "order_status", "track", "reschedule", "refund", "invoice", "complaint",
        "address_change", "lost_parcel", "damaged", "fraud_check",
        "out_of_scope", "multi_domain"
      ]
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "customer_request": {
      "type": "object",
      "required": ["text", "locale"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "locale": { "type": "string", "enum": ["ar", "en"] },
        "customer_id": { "type": ["string", "null"], "pattern": "^CUST-[0-9]{4}$" },
        "order_id": { "type": ["string", "null"], "pattern": "^TW-2026-[0-9]{5}$" }
      }
    },
    "applicable_policy": {
      "type": "object",
      "required": ["policy_ids", "policy_version"],
      "additionalProperties": false,
      "properties": {
        "policy_ids": { "type": "array", "items": { "type": "string" } },
        "policy_version": { "type": "string" },
        "citation_required": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "environment_state": {
      "type": "object",
      "required": ["base", "patch"],
      "additionalProperties": false,
      "properties": {
        "base": { "type": "string", "enum": ["seed"] },
        "patch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "orders": { "type": "object" },
            "customers": { "type": "object" },
            "payments": { "type": "object" },
            "events_by_order": { "type": "object" },
            "tickets_by_customer": { "type": "object" },
            "refund_ledger": { "type": "object" }
          }
        }
      }
    },
    "available_tools": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "expected_state_transition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool_sequence": { "type": "array", "items": { "type": "string" } },
        "state_diff": { "type": "object" },
        "requires_human_approval": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "pass_fail_criteria": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "must_call_tools": { "type": "array", "items": { "type": "string" } },
        "must_not_call_tools": { "type": "array", "items": { "type": "string" } },
        "refund_amount_max_sar": { "type": ["number", "null"] },
        "must_mention": { "type": "array", "items": { "type": "string" } },
        "must_not_mention": { "type": "array", "items": { "type": "string" } },
        "language_must_match_customer": { "type": "boolean" },
        "escalation_required": { "type": "boolean" },
        "clarifying_question_required": { "type": "boolean" },
        "policy_citation_required": { "type": "boolean" },
        "max_steps": { "type": "number" },
        "max_redundant_calls": { "type": "number" }
      }
    },
    "notes_for_instructor": { "type": "string", "minLength": 1 }
  }
}
